---
import { getSession } from "@zitadel/astro-auth/server";
import authConfig from "../../../auth.config.mjs";

import BlankLayout from "@/layouts/blank.astro";
import AdminLogin from "@/components/layouts/AdminLogin";
import Logo from "@/astros/Logo.astro";
import SiteTitle from "@/astros/SiteTitle.astro";

const session = await getSession(Astro.request, authConfig);

if (session && !session.error) {
  return Astro.redirect("/admin/review");
}
---

<BlankLayout>
  <AdminLogin client:load>
    <Logo
      slot="logo"
      className="size-16 rounded-2xl"
      iconClassName="text-3xl"
    />
    <SiteTitle slot="title" />
  </AdminLogin>
</BlankLayout>

---

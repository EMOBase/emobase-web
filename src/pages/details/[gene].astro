---
import { readItems } from "@directus/sdk";

import Layout from "@/layouts/default.astro";
import genomicsService from "@/utils/services/genomics";
import phenotypeService from "@/utils/services/phenotypeService";
import goAnnotationService from "@/utils/services/goAnnotationService";
import ontologyService from "@/utils/services/ontologyService";
import { directus } from "@/utils/directus";
import { mainSpecies } from "@/utils/mainSpecies";
import GeneDetails, {
  type GeneLinkTemplate,
} from "@/components/pages/details/GeneDetails";
import GeneNotFound from "@/components/pages/details/GeneNotFound";
import JBrowseGenomeView from "@/components/pages/details/GenomeBrowser/JBrowseGenomeView";
import { type Homolog } from "@/components/pages/details/OrthologySection/types";
import { getJBrowseLinkParams } from "@/utils/pages/details/browserLinkParams";
import {
  getJBrowseConfig,
  getZoomedInLocation,
} from "@/utils/pages/details/jbrowseConfig";
import { getCurrentVersionName } from "@/utils/pages/details/currentVersion";

const { fetchGenes, fetchIBs, fetchOrthology } = genomicsService();
const { fetchByGene: fetchPhenotypesByGene } = phenotypeService();
const { fetchByGenes: fetchGOByGenes } = goAnnotationService();
const { fetchByIds: fetchTermsByIds } = ontologyService("GO");

const { gene = "" } = Astro.params;

const geneInfo = (await fetchGenes(mainSpecies, [gene]))[0];

let dsRNAs: Awaited<ReturnType<typeof fetchIBs>> = [];
let phenotypes: Awaited<ReturnType<typeof fetchPhenotypesByGene>> = [];
let homologs: Homolog[] = [];
let linkTemplates: GeneLinkTemplate[] = [];
let browserLinkParams: Awaited<
  ReturnType<typeof getJBrowseLinkParams>
> | undefined;
let jbrowseConfig: Awaited<ReturnType<typeof getJBrowseConfig>> | undefined;
let zoomedInLocation: string | null = null;

if (geneInfo) {
  dsRNAs = mainSpecies === "Tcas" ? await fetchIBs(gene) : [];
  phenotypes = await fetchPhenotypesByGene(gene);

  const orthology = await fetchOrthology(gene);
  const orthologySources = (orthology.orthologs || []).reduce(
    (acc, o) => {
      if (o.source) {
        acc[o.gene] = [o.source, ...(acc[o.gene] || [])];
      }
      return acc;
    },
    {} as Record<string, string[]>,
  );

  const orthologousGenes = Object.entries(orthologySources)
    .sort(([, a], [, b]) => b.length - a.length)
    .map(([gene]) => gene);
  const anns = await fetchGOByGenes(orthologousGenes);
  const missingNames = new Set(
    anns.filter((a) => !a.term.name).map((a) => a.term.id),
  );
  if (missingNames.size > 0) {
    const terms = await fetchTermsByIds(Array.from(missingNames));
    const termMap = new Map(terms.map((t) => [t.id, t.name]));
    anns.forEach((a) => {
      if (!a.term.name) {
        a.term.name = termMap.get(a.term.id) || "";
      }
    });
  }
  const annsById = anns.reduce(
    (acc, a) => {
      acc[a.gene] = [...(acc[a.gene] ?? []), a];
      return acc;
    },
    {} as Record<string, typeof anns>,
  );

  const dmelGenes = await fetchGenes("Dmel", orthologousGenes);

  homologs = dmelGenes.map((gene) => ({
    id: gene.id,
    symbol: gene.symbol ?? "",
    fullname: gene.fullname ?? "",
    source: orthologySources[gene.id],
    annotations: annsById[gene.id],
  }));

  try {
    const items = await directus.request(readItems("gene_link_templates"));
    linkTemplates = items
      .map(({ label, template }) => ({
        label: label || "",
        template: template || "",
      }))
      .filter((link) => link.template.includes("{gene}"));
  } catch (err) {
    console.error(" Error fetching gene link templates:", err);
  }

  const currentVersionName = await getCurrentVersionName();

  try {
    browserLinkParams = await getJBrowseLinkParams(currentVersionName);
  } catch (err) {
    console.error("Error fetching JBrowse config:", err);
  }

  zoomedInLocation = getZoomedInLocation(geneInfo);
  if (zoomedInLocation) {
    try {
      jbrowseConfig = await getJBrowseConfig(
        zoomedInLocation,
        currentVersionName,
      );
    } catch (err) {
      console.error("Error building JBrowse config:", err);
    }
  }
}
---

<style is:global>
  #jbrowse-linear-genome-view > div > div {
    background: transparent;
  }
  #jbrowse-linear-genome-view > div > div > div {
    box-shadow: none;
  }
</style>

<Layout>
  {
    geneInfo ? (
      <GeneDetails
        gene={gene}
        linkTemplates={linkTemplates}
        geneInfo={geneInfo}
        dsRNAs={dsRNAs}
        phenotypes={phenotypes}
        homologs={homologs}
        browserLinkParams={browserLinkParams}
        client:load
      >
        <div slot="jbrowse-genome-view">
          <div id="jbrowse-styles-container" transition:persist />
          {jbrowseConfig ? (
            <JBrowseGenomeView
              config={jbrowseConfig}
              client:only="react"
              transition:persist="jbrowse"
            >
              <div
                slot="fallback"
                class="w-full h-[300px] flex items-center justify-center text-neutral-400 italic bg-neutral-50 rounded-lg border border-dashed border-neutral-200"
              >
                Loading Genome Browser...
              </div>
            </JBrowseGenomeView>
          ) : (
            <div class="w-full h-[300px] flex items-center justify-center text-neutral-400 italic bg-neutral-50 rounded-lg border border-dashed border-neutral-200">
              {zoomedInLocation
                ? "Failed to load the genome browser"
                : "Genome browser unavailable for this gene"}
            </div>
          )}
        </div>
      </GeneDetails>
    ) : (
      <GeneNotFound />
    )
  }
</Layout>
